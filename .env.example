# ─── LLM Provider (generation / judge models) ───
# Default: OpenRouter (https://openrouter.ai/api/v1)
# Override LLM_API_BASE for other providers:
#   LMStudio:   http://localhost:1234/v1
#   Ollama:     http://localhost:11434/v1
#   vLLM:       http://localhost:8000/v1
#   OpenAI:     https://api.openai.com/v1
#   Anthropic:  https://api.anthropic.com/v1
LLM_API_BASE=https://openrouter.ai/api/v1
LLM_API_KEY=            # defaults to OPENROUTER_API_KEY if unset
LLM_MODEL=              # defaults to OPENROUTER_MODEL or openai/gpt-4o-mini

OPENROUTER_API_KEY=
OPENROUTER_MODEL=openai/gpt-4o-mini

# ─── Embedding Provider ───
# Default: OpenAI (https://api.openai.com/v1)
# Override EMBED_API_BASE for local models:
#   LMStudio:   http://localhost:1234/v1
#   Ollama:     http://localhost:11434/v1
#   vLLM:       http://localhost:8000/v1
EMBED_API_BASE=https://api.openai.com/v1
EMBED_API_KEY=          # defaults to OPENAI_API_KEY if unset
EMBED_MODEL=text-embedding-3-small
EMBED_DIMENSIONS=512

OPENAI_API_KEY=

# ─── Vector Database ───
PINECONE_API_KEY=
VECTOR_DB=              # qdrant (local) or pinecone (cloud, default)
