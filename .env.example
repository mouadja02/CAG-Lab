# ─── LLM Provider (generation) ───
# OpenRouter is the default — supports 300+ models via one API key.
# Swap LLM_API_BASE for direct access:
#   OpenAI:    https://api.openai.com/v1
#   Anthropic: https://api.anthropic.com/v1
LLM_API_BASE=https://openrouter.ai/api/v1
LLM_API_KEY=            # defaults to OPENROUTER_API_KEY if unset
LLM_MODEL=              # defaults to OPENROUTER_MODEL or openai/gpt-4o-mini
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openai/gpt-4o-mini

# ─── Judge model (benchmark evaluation) ───
# Uses a separate model to avoid self-evaluation bias.
# openrouter/ prefix auto-routes to OpenRouter.
JUDGE_API_KEY=          # defaults to OPENROUTER_API_KEY
JUDGE_MODEL=openrouter/nvidia/nemotron-3-nano-30b-a3b:free

# ─── Embedding Provider ───
# text-embedding-3-small at 512d — matches the aws-docs index
EMBED_API_BASE=https://api.openai.com/v1
EMBED_API_KEY=          # defaults to OPENAI_API_KEY if unset
EMBED_MODEL=text-embedding-3-small
EMBED_DIMENSIONS=512
OPENAI_API_KEY=

# ─── Vector Database ───
PINECONE_API_KEY=
VECTOR_DB=              # qdrant (local) or pinecone (cloud, default)
